# ── 构建产物 ──────────────────────────────
# Maven 的构建输出目录，每次 build 都会重新生成，不进版本库
target/

# 编译产物
*.class
*.jar
*.war
*.ear

# ── IDE 配置 ──────────────────────────────
# IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.settings/
.classpath
.project

# VSCode
.vscode/

# ── 系统垃圾 ──────────────────────────────
.DS_Store
Thumbs.db

# ── 日志 ──────────────────────────────────
*.log
